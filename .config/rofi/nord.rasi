* {
    font:   "Plus Jakarta Sans Medium 11";

    bg0:     #1d2129;
    bg1:     #2e3440;
    bg2:     #3B4252;
    fg0:     #D8DEE9;

    accent-color:     #88C0D0;
    urgent-color:     #EBCB8B;

    background-color:   transparent;
    text-color:         @fg0;

    margin:     0;
    padding:    0;
    spacing:    0;
}

element-icon,
element-text {
    cursor: pointer;
}

window {
    location: center;
    anchor: center;
    width: 20em;
}

mainbox {
    background-color: @bg0;
    border: 1px solid;
    border-color: @bg1;
    border-radius: 8px;
    padding: 0.5em;
    children: [ listview ];
}

inputbar {
    padding: 0.5em 0.75em;
    spacing: 0.5em;
    border: 2px solid;
    border-color: @accent-color;
    border-radius: 8;
    background-color: @bg2;
    children: [icon-search, entry, prompt];
}

prompt {
    text-color: @fg0;
}

icon-search {
    expand: false;
    filename: "search";
    vertical-align: 0.5;
}

message, error-message {
    padding: 0.5em 0.75em;
    background-color: @bg0;
    text-color: @fg0;
    border-radius: 16px;
    border: 1px solid;
    border-color: @bg2;
}

listview {
    lines: 5;
    fixed-height: false;
    dynamic: true;
    margin: 0.5em 0 0 0;
    scrollbar: false;
    spacing: 8px;
}

element {
    orientation: horizontal;
    spacing: 0.5em;
    padding: 0.5em 0.75em;
    border-radius: 8px;
    height: 5em;
}

element normal urgent {
    text-color: @urgent-color;
}

element normal active {
    text-color: @accent-color;
}

element selected {
    background-color: @bg2;
}

element selected urgent {
    background-color: @urgent-color;
    text-color: @bg0;
}

element-text {
    text-color: inherit;
    highlight: none;
    vertical-align: 0.5;
}

element-text span {
    text-color: red;
}

element-icon {
    size: 1em;
}

